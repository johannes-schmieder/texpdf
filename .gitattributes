# These files are committed byte-for-byte from external generators/sources.
licenses/texlive/LPPL-1.2.txt -whitespace
tests/fixtures/real-world/latexlog-current/report.tex -whitespace

# These inputs participate byte-for-byte in bundle reconstruction or its
# source-bound validation. Preserve LF on Windows as well as Unix hosts.
bundle/resource-policy.json text eol=lf
bundle/resource-trace.txt.gz.b64 text eol=lf
